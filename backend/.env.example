# ==============================================================================
# PII Firewall - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' (or 'backend/.env') and fill in your values:
#   cp .env.example .env
#
# Note: '.env' is in .gitignore and will NEVER be committed or pushed to Git.
# ==============================================================================

# Google Gemini API Key (Optional - Free Tier)
# Obtain your free API key at: https://aistudio.google.com/app/apikey
# Leave blank to run 100% locally with the Context-Aware NLP Engine.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (Optional, defaults to gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite
